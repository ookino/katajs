{
  "name": "katajs-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "An opinionated framework for Hono on Cloudflare Workers.",
  "license": "MIT",
  "author": "Yaseer A. Okino <yaseerokino@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ookino/katajs.git"
  },
  "homepage": "https://github.com/ookino/katajs#readme",
  "bugs": {
    "url": "https://github.com/ookino/katajs/issues"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --parallel --filter './packages/*' dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3"
}
