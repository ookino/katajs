{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "showcase-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "placeholder-hyperdrive-id",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/katajs_showcase_test"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "AUDIT_QUEUE", "queue": "katajs-showcase-audit" }
    ],
    "consumers": [
      {
        "queue": "katajs-showcase-audit",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "katajs-showcase-audit-dlq"
      }
    ]
  }
}
