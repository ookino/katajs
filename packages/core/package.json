{
  "name": "@katajs/core",
  "version": "0.1.0",
  "description": "An opinionated framework for Hono on Cloudflare Workers — runtime.",
  "keywords": [
    "hono",
    "cloudflare",
    "workers",
    "framework",
    "typescript",
    "katajs"
  ],
  "license": "MIT",
  "author": "Yaseer A. Okino <yaseerokino@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ookino/katajs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ookino/katajs/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ookino/katajs/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hono/zod-validator": ">=0.4.0",
    "hono": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.8.0",
    "expect-type": "^1.1.0",
    "hono": "^4.12.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.5",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
