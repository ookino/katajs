{
  "name": "@katajs/devtools",
  "version": "1.0.0",
  "description": "Interactive devtools for katajs apps — graph, routes, container introspection.",
  "keywords": [
    "katajs",
    "devtools",
    "graph",
    "hono",
    "cloudflare",
    "workers"
  ],
  "license": "MIT",
  "author": "Yaseer A. Okino <yaseerokino@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ookino/katajs.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://github.com/ookino/katajs/tree/main/packages/devtools#readme",
  "bugs": {
    "url": "https://github.com/ookino/katajs/issues"
  },
  "type": "module",
  "bin": {
    "katajs-devtools": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && vite build",
    "build:ui": "vite build",
    "build:cli": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "chokidar": "^4.0.1",
    "kolorist": "^1.8.0",
    "tsx": "^4.19.2"
  },
  "peerDependencies": {
    "@katajs/core": "workspace:*"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@xyflow/react": "^12.3.5",
    "autoprefixer": "^10.4.20",
    "cmdk": "^1.0.4",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.14",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
